#!/bin/bash
# Array stopping: release /mnt (only processes that hold it), then persist state while it still exists.
S=/usr/local/emhttp/plugins/ai-assistant-claude/scripts
cd / || exit 0
[ -x "$S/stop-sessions.sh" ] && "$S/stop-sessions.sh" >/dev/null 2>&1
[ -x "$S/sync-state.sh" ] && timeout 60 "$S/sync-state.sh" --force >/dev/null 2>&1
exit 0
